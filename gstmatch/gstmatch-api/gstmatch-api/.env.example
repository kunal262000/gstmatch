# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8000

# ─── CORS — comma-separated list of allowed frontend origins ──────────────────
# Include your live domain (www and non-www) plus local dev.
ALLOWED_ORIGINS=http://localhost:3000,https://gstmatch.cyou,https://www.gstmatch.cyou

# ─── Supabase (optional — for persistent storage instead of in-memory) ─────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
