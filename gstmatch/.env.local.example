# ─── Backend API ─────────────────────────────────────────────────
# URL of your FastAPI backend (change to your Railway/Render URL in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Cashfree Payments (Payment Gateway) ──────────────────────────
# App ID + Secret Key — MUST be a matching pair (both sandbox OR both production)
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
# Environment: PRODUCTION or SANDBOX
CASHFREE_ENVIRONMENT=PRODUCTION
# Used by the client checkout SDK (production/sandbox) — keep in sync with CASHFREE_ENVIRONMENT
NEXT_PUBLIC_CASHFREE_MODE=production
# Webhook signing secret (set on the Cashfree "Add Policy" page -> Webhook Endpoints ->
# the signing key under your webhook endpoint) + optional verify flag.
# IMPORTANT: Must match the key Cashfree uses to sign webhook messages, otherwise
# production plan upgrades are skipped (fail-closed). Set to 'true' in production!
CASHFREE_WEBHOOK_SECRET=
CASHFREE_VERIFY_WEBHOOK=true
# Optional fallback name for the app id (used by client SDK detection)
NEXT_PUBLIC_CASHFREE_APP_ID=your_cashfree_app_id_here

# ─── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Site URL (used for SEO, sitemap, and the password-reset redirect) ──
# In production set this to your real deployed domain, e.g. https://gstmatch-six.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app
